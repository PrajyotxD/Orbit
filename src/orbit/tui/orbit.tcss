/* Orbit TUI theme — dark terminal, green/teal accents.
   Colours mirror the reference mockup (GitHub-dark-ish palette). */

Screen {
    background: #0a0e14;
    color: #adbac7;
    layers: base overlay;
    scrollbar-background: #0d1117;
    scrollbar-background-hover: #0d1117;
    scrollbar-background-active: #0d1117;
    scrollbar-color: #1c2128;
    scrollbar-color-hover: #30363d;
    scrollbar-color-active: #3fb950;
    scrollbar-corner-color: #0d1117;
    scrollbar-size: 1 1;
}

/* Scrollbars: Textual does NOT inherit scrollbar-* from Screen onto child
   scrollable widgets, so theme every scrollable container explicitly. Without
   this they fall back to the default primary-blue thumb (#003054). */
VerticalScroll, ListView, SourceDetails, #detail-code-wrap, #center {
    scrollbar-background: #0d1117;
    scrollbar-background-hover: #0d1117;
    scrollbar-background-active: #0d1117;
    scrollbar-color: #1c2128;
    scrollbar-color-hover: #30363d;
    scrollbar-color-active: #3fb950;
    scrollbar-corner-color: #0d1117;
    scrollbar-size: 1 1;
}

/* ---------------------------------------------------------------- top bar */
TopBar {
    dock: top;
    height: 1;
    width: 100%;
    background: #0d1117;
    color: #adbac7;
    padding: 0 1;
    border-bottom: solid #1c2128;
}

/* --------------------------------------------------------------- body row */
#body {
    width: 100%;
    height: 1fr;
}

/* ----------------------------------------------------------------- sidebar */
Sidebar {
    width: 32;
    min-width: 24;
    height: 1fr;
    background: #0d1117;
    border-right: solid #1c2128;
    padding: 1 1 0 1;
}

#logo {
    height: 3;
    padding: 0 1;
    margin-bottom: 1;
}

#nav {
    height: auto;
    background: transparent;
    border: none;
}

#nav > ListItem {
    padding: 0 1;
    height: 1;
    background: transparent;
    color: #adbac7;
}

#nav > ListItem.-highlight {
    background: #10231a;
    color: #3fb950;
}

#nav > ListItem:hover {
    background: #0f1b14;
}

#nav .nav-active {
    text-style: bold;
}

#info-box {
    height: auto;
    margin: 1 0 0 0;
    padding: 1;
    border: round #1c2128;
    color: #adbac7;
}

#quote {
    height: auto;
    margin-top: 1;
    padding: 0 1;
}

/* ------------------------------------------------------------- center panel */
#center {
    width: 1fr;
    min-width: 30;
    height: 1fr;
    padding: 1 2;
}

.view-title {
    text-style: bold;
    color: #e6edf3;
    height: 1;
}

.view-subtitle {
    color: #6e7681;
    height: auto;
    margin-bottom: 1;
}

#search-input, #index-input, #evidence-input, #validate-input {
    border: round #30363d;
    background: #0d1117;
    color: #e6edf3;
    height: 3;
    margin-bottom: 1;
}

#search-input:focus, #index-input:focus, #evidence-input:focus, #validate-input:focus {
    border: round #3fb950;
}

#filter-bar {
    height: 1;
    margin-bottom: 1;
    color: #6e7681;
}

.filter-tab {
    width: auto;
    height: 1;
    margin-right: 1;
    padding: 0 1;
    color: #6e7681;
}

.filter-tab:hover {
    background: #10231a;
    color: #3fb950;
}

.filter-tab-active {
    text-style: bold;
}

#filter-hint {
    width: auto;
    height: 1;
    color: #484f58;
}

/* ------------------------------------------------- index: db + progress */
#db-controls, #index-target {
    height: 3;
    width: 100%;
}

.field-label {
    width: 12;
    height: 3;
    content-align: left middle;
    color: #6e7681;
}

#db-select {
    width: 1fr;
    margin-bottom: 1;
}

#index-db-input {
    width: 1fr;
    border: round #30363d;
    background: #0d1117;
    color: #e6edf3;
    height: 3;
    margin-bottom: 1;
}

#index-db-input:focus {
    border: round #3fb950;
}

#result-meta {
    height: 1;
    color: #6e7681;
    margin-bottom: 1;
}

#results {
    height: 1fr;
    background: transparent;
    border: none;
}

#results > ListItem {
    height: auto;
    margin-bottom: 1;
    padding: 1;
    border: round #1c2128;
    background: #0d1117;
}

#results > ListItem.-highlight {
    border: round #3fb950;
    background: #0d1a12;
}

.result-card {
    height: auto;
    background: transparent;
}

/* The content views are stacked in a ContentSwitcher. */
ContentSwitcher {
    height: 1fr;
    width: 1fr;
}

.panel-scroll {
    height: 1fr;
    width: 1fr;
}

/* generic status / output blocks used by index, validate, conflicts, etc. */
.block {
    height: auto;
    border: round #1c2128;
    background: #0d1117;
    padding: 1;
    margin-bottom: 1;
}

.hint {
    color: #6e7681;
    height: auto;
}

#index-progress {
    height: 1;
    margin: 1 0;
}

#conflicts-list, #status-block, #mcp-block, #settings-block, #evidence-block, #validate-block, #index-log {
    height: 1fr;
    border: round #1c2128;
    background: #0d1117;
    padding: 1;
}

/* -------------------------------------------------------------- right panel */
SourceDetails {
    width: 60;
    min-width: 30;
    height: 1fr;
    background: #0d1117;
    border-left: solid #1c2128;
    padding: 1;
}

#detail-fileinfo {
    height: auto;
    padding: 1;
    border: round #1c2128;
    margin-bottom: 1;
}

#detail-code-wrap {
    height: 1fr;
    min-height: 8;
    border: round #1c2128;
    background: #010409;
    padding: 0 1;
    margin-bottom: 1;
    overflow-x: hidden;
}

#detail-code {
    height: auto;
    width: 1fr;
}

Collapsible {
    border: none;
    background: transparent;
    padding: 0;
    margin-bottom: 1;
}

Collapsible > Contents {
    padding: 0 0 0 1;
}

#detail-context, #detail-related {
    height: auto;
}

/* -------------------------------------------------------------- status bar */
StatusBar {
    dock: bottom;
    height: 1;
    width: 100%;
    background: #0d1117;
    color: #6e7681;
    padding: 0 1;
    border-top: solid #1c2128;
}

/* ----------------------------------------------------------- narrow layout */
/* When the terminal is narrow the app adds .narrow to Screen and the side
   panels collapse so the center view keeps working. */
Screen.narrow Sidebar {
    display: none;
}

Screen.narrow SourceDetails {
    display: none;
}

Screen.compact SourceDetails {
    display: none;
}

/* The app hides the Source Details panel on views that don't use it (Index,
   Conflicts, MCP, Settings), so an old hit can't sit there as stale context. */
SourceDetails.detail-hidden {
    display: none;
}
